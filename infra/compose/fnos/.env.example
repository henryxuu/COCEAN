# Compose identity and published image coordinates.
COMPOSE_PROJECT_NAME=cocean
COCEAN_REGISTRY=ghcr.io
COCEAN_IMAGE_NAMESPACE=replace-with-owner/cocean
COCEAN_VERSION=edge
NODE_IMAGE=node:22.22.0-bookworm-slim
# Optional build-only Debian mirror base URL; empty keeps the signed official source.
DEBIAN_MIRROR=
PNPM_VERSION=11.0.0

# FNOS user/group that must already have access to the bind-mounted folders.
PUID=1000
PGID=1000

# Replace every value below with an existing absolute directory shown by FNOS.
# Compose deliberately refuses to create the Music, Inbox, data or cache paths.
COCEAN_MUSIC_DIR=/replace/with/fnos/path/Music
COCEAN_DATA_DIR=/replace/with/fnos/path/cocean/data
COCEAN_CACHE_DIR=/replace/with/fnos/path/cocean/cache
COCEAN_INBOX_DIR=/replace/with/fnos/path/cocean/inbox
# Writable staging path for an FNOS-mounted USB volume. It may be an empty
# application directory until a removable volume is explicitly mounted there.
COCEAN_DELIVERY_DIR=/replace/with/fnos/path/cocean/delivery
# One-line bootstrap owner:password file. It seeds the first local account;
# later sign-in uses the COCEAN login page and supports multiple users.
COCEAN_WEB_AUTH_FILE=/replace/with/fnos/path/cocean/secrets/web-basic-auth.txt

# Only the Web service is published to the LAN.
COCEAN_HTTP_BIND=0.0.0.0
COCEAN_HTTP_PORT=18080
TZ=Asia/Shanghai
COCEAN_LOG_LEVEL=info
COCEAN_SESSION_TTL_HOURS=720
# Set true only when the published Web endpoint is HTTPS.
COCEAN_COOKIE_SECURE=false
COCEAN_APPLE_LOOKUP_ENABLED=true
COCEAN_EXTERNAL_LOOKUP_TIMEOUT_MS=8000

# Container memory ceilings. Worker usage includes reclaimable file page cache.
COCEAN_WEB_MEMORY_LIMIT=256m
COCEAN_SERVER_MEMORY_LIMIT=768m
COCEAN_WORKER_MEMORY_LIMIT=2g

# Worker runtime values mapped by the current implementation.
COCEAN_WORKER_POLL_MS=1500
COCEAN_FFPROBE_PATH=/usr/bin/ffprobe
COCEAN_FFPROBE_TIMEOUT_MS=30000
# Exact, case-sensitive paths relative to COCEAN_MUSIC_DIR. JSON only; no globs.
COCEAN_SCAN_EXCLUDE_DIRS=[]

# Reserved contract for optional deterministic lookup; the current scan task does not call it.
# Offline/local scanning remains the default.
# When enabled, contact must be a real project URL or monitored email alias.
COCEAN_MUSICBRAINZ_ENABLED=false
COCEAN_METADATA_CONTACT=

# Qobuz Provider is hard-disabled in the current release; no URL, Cookie or Token is accepted.

# Optional acceptance helper image.
PYTHON_IMAGE=python:3.13-alpine

# Full-library acceptance policy. Reports contain aggregate counts only.
COCEAN_ACCEPTANCE_MANIFEST_HASH=sha256
# Leave empty to create one new scan. Set only to reuse a previously verified scan job.
COCEAN_ACCEPTANCE_EXISTING_SCAN_ID=
# Exact lower-case extensions mapped to explicit maximum counts; default rejects all.
COCEAN_ACCEPTANCE_ALLOWED_UNSUPPORTED_EXTENSIONS={}
COCEAN_ACCEPTANCE_REQUEST_TIMEOUT=15
COCEAN_ACCEPTANCE_SCAN_TIMEOUT=7200
COCEAN_ACCEPTANCE_POLL_INTERVAL=2
COCEAN_ACCEPTANCE_MAX_FAILURES=0
COCEAN_ACCEPTANCE_MIN_ALBUMS=1
COCEAN_ACCEPTANCE_MIN_ARTWORKS=1
COCEAN_ACCEPTANCE_MAX_MISSING_ARTWORKS=0
COCEAN_ACCEPTANCE_MAX_ALBUM_ISSUES=0
COCEAN_ACCEPTANCE_MAX_IGNORED_FILES=0
COCEAN_ACCEPTANCE_MAX_SKIPPED_SYMLINKS=0
COCEAN_ACCEPTANCE_MAX_CUE_FILES=0
COCEAN_ACCEPTANCE_MAX_OTHER_ENTRIES=0
COCEAN_ACCEPTANCE_MAX_TAG_WARNINGS=0
COCEAN_ACCEPTANCE_MAX_TECHNICAL_WARNINGS=0
# representative=one Track; each-album=one per digital Album; each-track=all indexed Tracks.
COCEAN_ACCEPTANCE_LISTEN_MODE=each-track
