{
  "name": "@cocean/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:container": "node ../../scripts/build-container.mjs server",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**' --exclude '.cocean-runtime/**'"
  },
  "dependencies": {
    "@cocean/catalog-recommendation": "workspace:*",
    "@cocean/catalog-sources": "workspace:*",
    "@cocean/contracts": "workspace:*",
    "@cocean/database": "workspace:*",
    "@cocean/still-catalog": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.3",
    "basic-ftp": "5.0.5",
    "fastify": "5.11.3",
    "pino": "10.3.1",
    "zod": "4.4.3"
  }
}
