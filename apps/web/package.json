{
  "name": "@cocean/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:container": "node ../../scripts/build-container.mjs web",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --exclude 'dist/**' --exclude '.cocean-runtime/**'"
  },
  "dependencies": {
    "@cocean/contracts": "workspace:*",
    "@fontsource/noto-sans-sc": "5.3.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0"
  }
}
