{
  "name": "@cocean/media-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only audio file scanner for COCEAN",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**' --exclude '.cocean-runtime/**'",
    "fixtures:generate": "bash ./tests/generate-fixtures.sh",
    "fixtures:clean": "bash ./tests/cleanup-fixtures.sh",
    "test:integration": "bash ./tests/run-generated-integration.sh"
  },
  "dependencies": {
    "@cocean/contracts": "workspace:*",
    "music-metadata": "11.14.0"
  }
}
