{
  "name": "@cocean/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**' --exclude '.cocean-runtime/**'"
  },
  "dependencies": {
    "@cocean/contracts": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@cocean/still-catalog": "workspace:*",
    "@types/better-sqlite3": "9.6.0"
  }
}
