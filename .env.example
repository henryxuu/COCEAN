COCEAN_HOST=0.0.0.0
COCEAN_PORT=8787
COCEAN_DATABASE_PATH=/data/cocean.sqlite
COCEAN_MUSIC_ROOT=/library/music
COCEAN_CACHE_ROOT=/cache
COCEAN_SCAN_ON_START=false
COCEAN_DEMO_DATA=false
COCEAN_LOG_LEVEL=info
COCEAN_WORKER_POLL_MS=1500
# MusicBrainz 要求可识别的维护者联系方式；留空时信息匹配不会发起外网请求。
COCEAN_MUSICBRAINZ_ENABLED=false
COCEAN_METADATA_CONTACT=
COCEAN_MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2/
COCEAN_STILL_CATALOG_PATH=/data/still-catalog.json
COCEAN_LLM_ENABLED=false
COCEAN_QOBUZ_ENABLED=false
